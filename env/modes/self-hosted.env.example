# Managed self-hosted/private-cloud development.
DATABASE_URL=postgres://openleash:openleash@localhost:9543/openleash
OPENLEASH_DEPLOYMENT_MODE=private
OPENLEASH_DEV_ORG_SLUG=self-hosted

# Client-facing API.
OPENLEASH_API_PORT=9318
OPENLEASH_API_SURFACE=client
OPENLEASH_CLIENT_API_URL=http://127.0.0.1:9318
OPENLEASH_RELEASE_ADMIN_TOKEN=replace-with-a-long-random-release-admin-token

# Dashboard-facing API and web app.
OPENLEASH_DASHBOARD_PORT=9301
OPENLEASH_DASHBOARD_API_URL=http://localhost:9319
OPENLEASH_API_URL=http://localhost:9319
NEXT_PUBLIC_OPENLEASH_API_URL=http://localhost:9319

# Optional customer-owned evaluator key.
OPENAI_API_KEY=
OPENAI_EVAL_MODEL=gpt-5.2
