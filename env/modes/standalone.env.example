# Standalone mode runs only the desktop client.
# No Postgres, dashboard-api, dashboard-web, or remote client-api is required.
OPENLEASH_CLIENT_MODE=standalone
OPENLEASH_STANDALONE=true

# Optional. Used for local LLM evaluation when the user chooses an OpenAI provider.
OPENAI_API_KEY=
OPENAI_EVAL_MODEL=gpt-5.2
