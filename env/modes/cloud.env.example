# Local simulation of OpenLeash Cloud.
# Real OpenLeash-hosted adapters, credentials, billing, abuse controls, and ops automation stay private.
DATABASE_URL=postgres://openleash:openleash@localhost:9543/openleash
OPENLEASH_DEPLOYMENT_MODE=cloud
OPENLEASH_DEV_ORG_SLUG=openleash-cloud
OPENLEASH_TENANT_DOMAIN=openleash.local

# Client-facing API.
OPENLEASH_API_PORT=9318
OPENLEASH_API_SURFACE=client
OPENLEASH_CLIENT_API_URL=http://127.0.0.1:9318
OPENLEASH_CLOUD_CLIENT_API_URL=http://localhost:9318
NEXT_PUBLIC_CLOUD_CLIENT_API_URL=http://localhost:9318
OPENLEASH_RELEASE_ADMIN_TOKEN=replace-with-a-long-random-release-admin-token

# Dashboard-facing API and web app.
OPENLEASH_DASHBOARD_PORT=9302
OPENLEASH_DASHBOARD_API_URL=http://localhost:9319
OPENLEASH_API_URL=http://localhost:9319
NEXT_PUBLIC_OPENLEASH_API_URL=http://localhost:9319
NEXT_PUBLIC_CLOUD_DASHBOARD_API_URL=http://localhost:9319

# Optional local model key for dev. Production cloud keys belong in the private cloud adapter layer.
OPENAI_API_KEY=
OPENAI_EVAL_MODEL=gpt-5.2
