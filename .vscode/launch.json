{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Leash: Personal Open Source",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:mode:individual-open-source",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Leash: Cloud Development",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:mode:cloud",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Leash: Main Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:main-web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Leash: Docs Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:docs-web",
      "cwd": "${workspaceFolder}"
    }
  ]
}
