{
  "id": "acme.command-review",
  "slug": "command-review",
  "name": "Command Review",
  "description": "Example isolated OpenLeash event plugin.",
  "version": "1.0.0",
  "publisher": "acme",
  "runtime": "container",
  "execution": {
    "type": "container",
    "placement": "server",
    "protocol": "openleash-container-plugin.v1",
    "image": "ghcr.io/acme/openleash-command-review:1.0.0",
    "digest": "sha256:replace-with-the-published-image-digest",
    "healthPath": "/healthz",
    "eventPath": "/v1/events",
    "timeoutMs": 5000,
    "failureMode": "closed",
    "resources": { "memoryMb": 128, "cpuShares": 128 },
    "storage": { "persistent": false }
  },
  "entrypoint": "container",
  "events": ["tool.beforeUse"],
  "permissions": ["event:read", "tool:read", "decision:write"],
  "effects": ["observe", "ask"],
  "defaultConfig": { "enabled": true }
}
