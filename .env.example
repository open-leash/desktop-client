DATABASE_URL=postgres://openleash:openleash@localhost:5432/openleash

# Product modes:
# - standalone: desktop-client only; local API on 127.0.0.1:4317; no Postgres required.
# - self-hosted/private: customer-hosted client-api + dashboard-api + dashboard-web.
# - cloud: OpenLeash-hosted client-api/dashboard services; local dev simulates this with the same OSS services.
OPENLEASH_DEPLOYMENT_MODE=private
# One-time value used only to create the first Private Cloud recovery owner.
# Generate a long random value, keep it in the deployment secret store, and
# rotate or remove it after workforce identity and a second administrator exist.
OPENLEASH_PRIVATE_BOOTSTRAP_TOKEN=

# Managed local development ports.
OPENLEASH_API_PORT=4318
OPENLEASH_API_SURFACE=client
OPENLEASH_CLIENT_API_URL=http://localhost:4318
OPENLEASH_DASHBOARD_API_URL=http://localhost:4319
OPENLEASH_CLOUD_CLIENT_API_URL=http://localhost:4318
OPENLEASH_API_URL=http://localhost:4319
OPENLEASH_PUBLIC_API_URL=http://localhost:4318
NEXT_PUBLIC_CLOUD_CLIENT_API_URL=http://localhost:4318
NEXT_PUBLIC_CLOUD_DASHBOARD_API_URL=http://localhost:4319
OPENLEASH_TENANT_URL=openleash.local
OPENLEASH_TENANT_DOMAIN=openleash.local
OPENLEASH_SSO_REDIRECT_URI=
OPENLEASH_DASHBOARD_PORT=3001
OPENLEASH_DASHBOARD_ORIGIN=http://localhost:3001
OPENAI_API_KEY=
OPENAI_EVAL_MODEL=gpt-5.2
OPENLEASH_DEV_TOKEN=openleash-dev-token
IDENTITY_LOADER_URL=

# Client updates are served by client-api.
# Public cloud clients default to https://api.openleash.com/api/updates/check.
# Private/on-prem clients can set OPENLEASH_UPDATE_FEED_URL to their own client-api endpoint or static JSON.
# Set OPENLEASH_UPDATE_MODE=manual to disable public update checks and distribute updates yourself.
OPENLEASH_RELEASE_ADMIN_TOKEN=dev-release-admin-token
OPENLEASH_UPDATE_MODE=public
OPENLEASH_UPDATE_FEED_URL=http://localhost:4318/api/updates/check
OPENLEASH_UPDATE_CHANNEL=stable
OPENLEASH_LATEST_VERSION=
OPENLEASH_LATEST_DMG_URL=
OPENLEASH_LATEST_SHA256=
OPENLEASH_LATEST_NOTES_URL=

# Cloud / Private identity providers. Required when SSO/OAuth is enabled.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENLEASH_GOOGLE_CLIENT_ID=
OPENLEASH_GOOGLE_CLIENT_SECRET=
OPENLEASH_GOOGLE_REDIRECT_URI=
OPENLEASH_GOOGLE_IOS_CLIENT_ID=
OPENLEASH_GOOGLE_IOS_REVERSED_CLIENT_ID=
OPENLEASH_GOOGLE_ANDROID_CLIENT_ID=
OPENLEASH_GOOGLE_ANDROID_PROJECT_ID=
MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OPENLEASH_MICROSOFT_TENANT_ID=
OPENLEASH_MICROSOFT_CLIENT_ID=
OPENLEASH_MICROSOFT_CLIENT_SECRET=
OPENLEASH_MICROSOFT_REDIRECT_URI=

# Billing / managed model usage. Lemon Squeezy checkout is created server-side.
# Server-side billing secrets belong in the OpenLeash Cloud adapter layer, not the public core.
LEMON_SQUEEZY_MODE=test
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_PERSONAL_MANAGED=
LEMON_SQUEEZY_VARIANT_WORK_MANAGED=
LEMON_SQUEEZY_VARIANT_WORK_BYOK=
LEMON_SQUEEZY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# External agent monitoring. Set OPENLEASH_EXTERNAL_AGENTS_MOCK=true to demo without vendor credentials.
OPENLEASH_EXTERNAL_AGENTS_MOCK=

# Microsoft Copilot Studio / Agent 365. Dataverse token needs conversation transcript read access.
MICROSOFT_COPILOT_DATAVERSE_URL=
MICROSOFT_COPILOT_DATAVERSE_TOKEN=
MICROSOFT_COPILOT_AGENT_ID=
MICROSOFT_COPILOT_AGENT_IDS=
MICROSOFT_COPILOT_AGENTS_JSON=
MICROSOFT_COPILOT_CONVERSATION_IDS=
MICROSOFT_COPILOT_TRANSCRIPT_URL_TEMPLATE=

# Salesforce Agentforce. Use a Salesforce OAuth access token that can read Agentforce/session trace data.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_AGENTFORCE_AGENT_ID=
SALESFORCE_AGENTFORCE_AGENT_IDS=
SALESFORCE_AGENTFORCE_AGENTS_JSON=
SALESFORCE_AGENTFORCE_SESSION_IDS=
SALESFORCE_AGENTFORCE_TRACE_URL_TEMPLATE=

# Azure AI Foundry Agent Service. Token must be a Microsoft Entra bearer token with AI Foundry project access.
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_TOKEN=
AZURE_AI_FOUNDRY_API_VERSION=v1
AZURE_AI_FOUNDRY_AGENT_ID=
AZURE_AI_FOUNDRY_AGENT_IDS=
AZURE_AI_FOUNDRY_AGENTS_JSON=
AZURE_AI_FOUNDRY_THREAD_IDS=

# AWS Bedrock Agents / AgentCore. The trace template should return messages, events, or trace text.
AWS_REGION=
AWS_BEDROCK_AGENT_ID=
AWS_BEDROCK_AGENT_IDS=
AWS_BEDROCK_AGENTS_JSON=
AWS_BEDROCK_SESSION_IDS=
AWS_BEDROCK_AGENTCORE_TRACE_URL_TEMPLATE=

# Google Vertex AI / Gemini Enterprise. Token needs Agent Engine session/event read access.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
GOOGLE_VERTEX_AI_ACCESS_TOKEN=
GOOGLE_VERTEX_AGENT_ENGINE_ID=
GOOGLE_VERTEX_AGENT_ENGINE_IDS=
GOOGLE_VERTEX_AGENTS_JSON=
GOOGLE_VERTEX_SESSION_IDS=
GOOGLE_VERTEX_TRANSCRIPT_URL_TEMPLATE=

# n8n Cloud or self-hosted/on-prem Docker.
N8N_BASE_URL=
N8N_API_KEY=
N8N_WORKFLOW_ID=
N8N_WORKFLOW_IDS=
N8N_AGENTS_JSON=
N8N_EXECUTION_IDS=

# Zapier Agents / Zapier AI. Transcript template should return messages, events, or transcript text.
ZAPIER_API_KEY=
ZAPIER_AGENT_ID=
ZAPIER_AGENT_IDS=
ZAPIER_AGENTS_JSON=
ZAPIER_CONVERSATION_IDS=
ZAPIER_AGENT_TRANSCRIPT_URL_TEMPLATE=

# Main-web social feed cards. Optional; when unset the site shows profile follow cards.
# X uses the official API v2 user posts endpoint.
X_BEARER_TOKEN=
X_USERNAME=OpenLeashCom
X_USER_ID=
# LinkedIn uses the official REST Posts API. The token needs organization post read access.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_VERSION=202606
